import { Tokens } from "../tokens.slint";
import { Shell } from "../shell.slint";

// Per-app hero crop (src/sgdb/hero_crop.rs): zoom 1..3, pan -1..1 (-1 = image edge on frame edge). Same transform everywhere.
export struct HeroFrame { zoom: float, pan-x: float, pan-y: float, }

// Cover-fitted image with the hero crop applied (src/sgdb/hero_crop.rs `placement`): the image is cover-fitted to the frame, scaled by
// zoom, and placed at x = (w - sw) * (1 + pan-x) / 2 (same for y). The cover overflows the frame in one axis, so pan works at zoom 1 too.
export component CroppedImage inherits Rectangle {
    in property <image> src;
    in property <HeroFrame> crop: { zoom: 1, pan-x: 0, pan-y: 0 };
    in property <float> kb-scale: 1.0;
    // frame px per source px for the cover fit, then zoom
    property <float> k: max(root.width / 1px / max(root.src.width, 1), root.height / 1px / max(root.src.height, 1)) * max(root.crop.zoom, 1);
    property <length> iw: max(root.src.width, 1) * root.k * 1px;
    property <length> ih: max(root.src.height, 1) * root.k * 1px;
    clip: true;
    Rectangle {
        width: root.width; height: root.height;
        transform-scale: root.kb-scale;
        transform-origin: { x: 0px, y: root.height };
        Image {
            x: (root.width - root.iw) * (1 + root.crop.pan-x) / 2;
            y: (root.height - root.ih) * (1 + root.crop.pan-y) / 2;
            width: root.iw; height: root.ih; source: root.src; image-fit: fill;
        }
    }
}

// Hero crossfade: incoming scale(1.03) op 0 -> 1, outgoing translateX(-32) scale(1.08) op 1 -> 0, 300ms ease-hero; ken-burns 1.0 -> 1.1 over 25s.
export component HeroImg inherits Rectangle {
    in property <image> src;
    in property <bool> active;
    in property <bool> kb;
    in property <HeroFrame> crop: { zoom: 1, pan-x: 0, pan-y: 0 };
    clip: true;
    opacity: 0;
    property <float> sc: Tokens.hero-old-scale;
    property <length> shift: -Tokens.hero-old-shift;
    states [
        on when root.active: {
            opacity: 1; sc: 1.0; shift: 0px;
            in { animate opacity, sc, shift { duration: Tokens.dur-hero; easing: Tokens.ease-hero; } }
            out { animate opacity, sc, shift { duration: Tokens.dur-hero; easing: Tokens.ease-hero; } }
        }
    ]
    Rectangle {
        x: root.shift; y: 0px; width: parent.width; height: parent.height;
        transform-scale: root.sc;
        transform-origin: { x: 0px, y: parent.height };
        CroppedImage { x: 0px; y: 0px; width: parent.width; height: parent.height; src: root.src; crop: root.crop;
            kb-scale: root.kb ? Shell.kb : 1.0; }
    }
}
