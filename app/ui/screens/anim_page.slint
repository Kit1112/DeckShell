// Settings → «Анимации» (task 412): boot / sleep animations, the user's animations and the steamdeckrepo.com catalog.
// Geometry is computed in src/screens/anim_page.rs (absolute window px inside the settings content, like GPageRows), so the
// layout lint and the pad focus table in Rust test exactly what is drawn. Fonts, colours and focus follow the other settings
// pages: labels #dcdedf 19.2px, descriptions #8b929a 16.8px, focused controls white with dark text, panels #23262e.
import { Tokens } from "../tokens.slint";
import { Toggle } from "../widgets/toggle.slint";

export struct AnimItem {
    kind: int,
    x: length, y: length, w: length, h: length,
    label: string, value: string, desc: string,
    badge: string, badge2: string,
    on: int,
    progress: float,
    img: image, has-img: bool,
}

export global AnimPageState {
    in property <string> label-standard-steam-animation;
    in property <[AnimItem]> items;
    in property <int> focus: -1;
    in property <bool> active;
    // the one animated preview: drawn in item `preview-owner` (hero, focused card) or in the modal's preview box
    in property <image> preview;
    in property <bool> has-preview;
    in property <int> preview-owner: -1;
    in property <bool> preview-in-modal;
    // modal (picker / actions / details / confirm)
    in property <bool> modal;
    in property <string> modal-title;
    in property <length> mx; in property <length> my; in property <length> mw; in property <length> mh;
    in property <[AnimItem]> modal-items;
    in property <int> modal-focus: -1;
    // list area of the modal (kind 20 options are laid out inside it and scroll with modal-vy)
    in property <length> lx; in property <length> ly; in property <length> lw; in property <length> lh;
    in property <length> list-h;
    in property <length> modal-vy;
    callback activated(int);
    callback modal-activated(int);
    callback modal-dismiss();
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    height: 22px;
    width: t.preferred-width + 14px;
    border-radius: 3px;
    background: accent ? Tokens.accent : #000000b0;
    t := Text { x: 7px; height: parent.height; text: root.text; color: #ffffff; font-size: 13px; font-weight: 700; vertical-alignment: center; }
}

component Preview inherits Rectangle {
    in property <image> img;
    in property <bool> has-img;
    in property <string> empty;
    background: #0e141b;
    border-radius: 4px;
    clip: true;
    if root.has-img: Image { width: parent.width; height: parent.height; source: root.img; image-fit: contain; }
    if !root.has-img: Text { width: parent.width; height: parent.height; text: root.empty; color: #8b929a; font-size: 16.8px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
}

export component AnimPage inherits Rectangle {
    for r[i] in AnimPageState.items: Rectangle {
        x: r.x; y: r.y; width: r.w; height: r.h;
        property <bool> foc: AnimPageState.active && AnimPageState.focus == i && !AnimPageState.modal;
        accessible-role: button;
        accessible-label: r.label;
        accessible-description: "anim|" + r.kind + "|" + r.value;
        accessible-checkable: r.kind == 4 || r.kind == 9;
        accessible-checked: r.on == 1;
        // 1: tab pill (on = current tab)
        if r.kind == 1: Rectangle {
            border-radius: self.height / 2;
            background: foc ? #ffffff : (r.on == 1 ? #ffffff26 : transparent);
            animate background { duration: Tokens.dur-pill; }
            Text { width: parent.width; height: parent.height; text: r.label; color: foc ? #23262e : (r.on == 1 ? #ffffff : #dcdedf); font-size: 16.8px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        // 2: section header
        if r.kind == 2: Text { y: 0px; width: parent.width; height: parent.height; text: r.label; color: #ffffff; font-size: 19.2px; font-weight: 700; vertical-alignment: bottom; overflow: elide; }
        // 3: value row (drop-down button), 5: button row, 16: stepper row
        if r.kind == 3 || r.kind == 5 || r.kind == 16: Rectangle {
            clip: true;
            Text { x: 0px; y: r.desc == "" ? (parent.height - 26px) / 2 : 10px; width: parent.width - 384px; height: 26px; text: r.label; color: #dcdedf; font-size: 19.2px; vertical-alignment: center; overflow: elide; }
            if r.desc != "": Text { x: 0px; y: 38px; width: parent.width - 384px; height: parent.height - 42px; text: r.desc; color: #8b929a; font-size: 16.8px; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
            Rectangle {
                x: parent.width - 360px; y: (parent.height - 44px) / 2; width: 360px; height: 44px; border-radius: 2px;
                background: foc ? #ffffff : (r.on < 0 ? #ffffff0d : #ffffff1f);
                animate background { duration: Tokens.dur-btn; easing: ease-out; }
                if r.kind == 3: Text { x: 14px; width: parent.width - 44px; height: parent.height; text: r.value; color: foc ? #0e141b : (r.on < 0 ? #8b929a : #dcdedf); font-size: 18px; vertical-alignment: center; overflow: elide; }
                if r.kind == 3: Text { x: parent.width - 28px; width: 18px; height: parent.height; text: "⌄"; color: foc ? #0e141b : #8b929a; font-size: 18px; vertical-alignment: center; }
                if r.kind == 5: Text { width: parent.width; height: parent.height; text: r.value; color: foc ? #0e141b : (r.on < 0 ? #8b929a : #dcdedf); font-size: 18px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                if r.kind == 16: Text { x: 12px; width: 24px; height: parent.height; text: "‹"; color: foc ? #0e141b : #8b929a; font-size: 22px; vertical-alignment: center; }
                if r.kind == 16: Text { x: 40px; width: parent.width - 80px; height: parent.height; text: r.value; color: foc ? #0e141b : #dcdedf; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
                if r.kind == 16: Text { x: parent.width - 36px; width: 24px; height: parent.height; text: "›"; color: foc ? #0e141b : #8b929a; font-size: 22px; vertical-alignment: center; horizontal-alignment: right; }
                if r.kind == 16: Rectangle { x: 40px; y: parent.height - 6px; width: (parent.width - 80px) * r.progress; height: 3px; background: foc ? #1a9fff : #1a9fffaa; }
            }
        }
        // 4: toggle row
        if r.kind == 4: Rectangle {
            clip: true;
            Text { x: 0px; y: r.desc == "" ? (parent.height - 26px) / 2 : 10px; width: parent.width - 120px; height: 26px; text: r.label; color: #dcdedf; font-size: 19.2px; vertical-alignment: center; overflow: elide; }
            if r.desc != "": Text { x: 0px; y: 38px; width: parent.width - 120px; height: parent.height - 42px; text: r.desc; color: #8b929a; font-size: 16.8px; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
            Toggle { x: parent.width - 16px - self.width; y: (parent.height - self.height) / 2; on: r.on; focused: foc; }
        }
        // 6: animation card (thumb 16:10 + name + meta)
        if r.kind == 6: Rectangle {
            property <length> th: self.width * 0.625;
            border-radius: 4px;
            background: foc ? #3d4450 : #23262e;
            animate background { duration: Tokens.dur-btn; easing: ease-out; }
            Rectangle {
                x: 0px; y: 0px; width: parent.width; height: parent.th; clip: true; border-radius: 4px; background: #0e141b;
                if r.has-img && !(AnimPageState.preview-owner == i && AnimPageState.has-preview && !AnimPageState.preview-in-modal): Image { width: parent.width; height: parent.height; source: r.img; image-fit: cover; }
                if AnimPageState.preview-owner == i && AnimPageState.has-preview && !AnimPageState.preview-in-modal: Image { width: parent.width; height: parent.height; source: AnimPageState.preview; image-fit: cover; }
                if !r.has-img: Text { width: parent.width; height: parent.height; text: r.value; color: #8b929a; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
                if r.badge != "": Badge { x: 8px; y: 8px; text: r.badge; }
                if r.badge2 != "": Badge { x: parent.width - self.width - 8px; y: 8px; text: r.badge2; accent: r.on == 1; }
                if r.progress >= 0: Rectangle { x: 0px; y: parent.height - 6px; width: parent.width; height: 6px; background: #000000b0;
                    Rectangle { x: 0px; width: parent.width * clamp(r.progress, 0, 1); height: parent.height; background: Tokens.accent; }
                }
            }
            Text { x: 10px; y: parent.th + 8px; width: parent.width - 20px; height: 24px; text: r.label; color: #ffffff; font-size: 17px; font-weight: 700; vertical-alignment: center; overflow: elide; }
            Text { x: 10px; y: parent.th + 33px; width: parent.width - 20px; height: 20px; text: r.desc; color: foc ? #dcdedf : #8b929a; font-size: 14.4px; vertical-alignment: center; overflow: elide; }
            Rectangle { border-radius: 4px; border-width: foc ? 2.4px : 0px; border-color: #ffffffcc; }
        }
        // 7: search field, 8: filter drop-down, 14: small button
        if r.kind == 7 || r.kind == 8 || r.kind == 14: Rectangle {
            border-radius: 2px;
            background: foc ? #ffffff : #ffffff1a;
            animate background { duration: Tokens.dur-btn; easing: ease-out; }
            if r.kind == 7: Text { x: 12px; width: 22px; height: parent.height; text: "⌕"; color: foc ? #0e141b : #8b929a; font-size: 20px; vertical-alignment: center; }
            if r.kind == 7: Text { x: 38px; width: parent.width - 48px; height: parent.height; text: r.value != "" ? r.value : r.label; color: foc ? #0e141b : (r.value != "" ? #dcdedf : #8b929a); font-size: 17px; vertical-alignment: center; overflow: elide; }
            if r.kind == 8: Text { x: 12px; width: parent.width - 36px; height: parent.height; text: r.value; color: foc ? #0e141b : #dcdedf; font-size: 17px; vertical-alignment: center; overflow: elide; }
            if r.kind == 8: Text { x: parent.width - 24px; width: 16px; height: parent.height; text: "⌄"; color: foc ? #0e141b : #8b929a; font-size: 17px; vertical-alignment: center; }
            if r.kind == 14: Text { width: parent.width; height: parent.height; text: r.label; color: foc ? #0e141b : (r.on < 0 ? #8b929a : #dcdedf); font-size: 17px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        // 9: filter pill toggle
        if r.kind == 9: Rectangle {
            border-radius: self.height / 2;
            background: foc ? #ffffff : (r.on == 1 ? Tokens.accent : #ffffff1a);
            animate background { duration: Tokens.dur-pill; }
            Text { width: parent.width; height: parent.height; text: r.label; color: foc ? #0e141b : #ffffff; font-size: 15.6px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        // 10: status line (on 2 warning, 3 error)
        if r.kind == 10: Text { width: parent.width; height: parent.height; text: r.label; color: r.on == 3 ? #ef806c : (r.on == 2 ? #ffc82c : #8b929a); font-size: 16px; vertical-alignment: center; overflow: elide; }
        // 11: hero: preview + what plays
        if r.kind == 11: Rectangle {
            Preview { x: 0px; y: 0px; width: 336px; height: 210px; img: AnimPageState.preview-owner == i && AnimPageState.has-preview && !AnimPageState.preview-in-modal ? AnimPageState.preview : r.img;
                has-img: (AnimPageState.preview-owner == i && AnimPageState.has-preview && !AnimPageState.preview-in-modal) || r.has-img; empty: AnimPageState.label-standard-steam-animation; }
            Text { x: 360px; y: 4px; width: parent.width - 360px; height: 20px; text: r.value; color: #8b929a; font-size: 14.4px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; overflow: elide; }
            Text { x: 360px; y: 28px; width: parent.width - 360px; height: 64px; text: r.label; color: #ffffff; font-size: 24px; font-weight: 700; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
            Text { x: 360px; y: 96px; width: parent.width - 360px; height: 114px; text: r.desc; color: #8b929a; font-size: 16.8px; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
        }
        // 12: info row (label left, value right)
        if r.kind == 12: Rectangle {
            Text { x: 0px; width: parent.width * 0.55; height: parent.height; text: r.label; color: #dcdedf; font-size: 19.2px; vertical-alignment: center; overflow: elide; }
            Text { x: parent.width * 0.55; width: parent.width * 0.45; height: parent.height; text: r.value; color: #8b929a; font-size: 17px; horizontal-alignment: right; vertical-alignment: center; overflow: elide; }
        }
        // 13: paragraph
        if r.kind == 13: Text { width: parent.width; height: parent.height; text: r.label; color: #8b929a; font-size: 16px; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
        // 15: empty state
        if r.kind == 15: Rectangle {
            border-radius: 4px; background: #ffffff08;
            Text { x: 24px; width: parent.width - 48px; height: parent.height; text: r.label; color: #8b929a; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
        }
        if r.kind != 2 && r.kind != 10 && r.kind != 12 && r.kind != 13: TouchArea { clicked => { AnimPageState.activated(i); } }
    }
}

// Modal over the whole settings screen: picker, actions, details, confirmation.
export component AnimModal inherits Rectangle {
    background: #000000a8;
    TouchArea { clicked => { AnimPageState.modal-dismiss(); } }
    Rectangle {
        x: AnimPageState.mx; y: AnimPageState.my; width: AnimPageState.mw; height: AnimPageState.mh;
        background: #23262e; border-radius: 6px;
        drop-shadow-blur: 24px; drop-shadow-color: #00000080;
        TouchArea { }
        Text { x: 24px; y: 16px; width: parent.width - 48px; height: 32px; text: AnimPageState.modal-title; color: #ffffff; font-size: 22px; font-weight: 700; vertical-alignment: center; overflow: elide; }
        // list area
        Rectangle {
            x: AnimPageState.lx; y: AnimPageState.ly; width: AnimPageState.lw; height: AnimPageState.lh; clip: true;
            Rectangle {
                y: -AnimPageState.modal-vy; width: parent.width; height: AnimPageState.list-h;
                animate y { duration: 120ms; easing: ease-out; }
                for r[i] in AnimPageState.modal-items: Rectangle {
                    visible: r.kind == 20;
                    x: r.x; y: r.y; width: r.w; height: r.h;
                    property <bool> foc: AnimPageState.modal-focus == i;
                    accessible-role: button; accessible-label: r.label; accessible-description: "anim-option|" + r.value;
                    border-radius: 2px;
                    background: foc ? #ffffff : transparent;
                    animate background { duration: Tokens.dur-pill; }
                    Text { x: 16px; width: parent.width - 120px; height: parent.height; text: r.label; color: foc ? #0e141b : (r.on < 0 ? #8b929a : #dcdedf); font-size: 19.2px; vertical-alignment: center; overflow: elide; }
                    Text { x: parent.width - 104px; width: 88px; height: parent.height; text: r.value; color: foc ? #0e141b : (r.on == 1 ? Tokens.accent : #8b929a); font-size: 17px; horizontal-alignment: right; vertical-alignment: center; }
                    if r.kind == 20: TouchArea { clicked => { AnimPageState.modal-activated(i); } }
                }
            }
        }
        for r[i] in AnimPageState.modal-items: Rectangle {
            visible: r.kind != 20;
            x: r.x; y: r.y; width: r.w; height: r.h;
            property <bool> foc: AnimPageState.modal-focus == i;
            accessible-role: button; accessible-label: r.label; accessible-description: "anim-modal|" + r.kind;
            if r.kind == 21: Preview { width: parent.width; height: parent.height; img: AnimPageState.preview-in-modal && AnimPageState.has-preview ? AnimPageState.preview : r.img;
                has-img: (AnimPageState.preview-in-modal && AnimPageState.has-preview) || r.has-img; empty: r.value; }
            if r.kind == 22: Rectangle {
                clip: true;
                Text { y: 0px; width: parent.width; height: 60px; text: r.label; color: #ffffff; font-size: 22px; font-weight: 700; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
                Text { y: 64px; width: parent.width; height: 48px; text: r.value; color: #dcdedf; font-size: 16px; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
                Text { y: 116px; width: parent.width; height: parent.height - 116px; text: r.desc; color: #8b929a; font-size: 16px; wrap: word-wrap; vertical-alignment: top; overflow: elide; }
            }
            if r.kind == 23: Rectangle {
                border-radius: 2px; clip: true;
                background: foc ? #ffffff : (r.on == 2 ? #b0322a : (r.on < 0 ? #ffffff0d : #ffffff1f));
                animate background { duration: Tokens.dur-btn; easing: ease-out; }
                if r.progress >= 0: Rectangle { x: 0px; width: parent.width * clamp(r.progress, 0, 1); height: parent.height; background: foc ? #1a9fff66 : #1a9fff55; }
                Text { x: 8px; width: parent.width - 16px; height: parent.height; text: r.label; color: foc ? #0e141b : (r.on < 0 ? #8b929a : #ffffff); font-size: 18px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
                TouchArea { clicked => { AnimPageState.modal-activated(i); } }
            }
            if r.kind == 24: Text { width: parent.width; height: parent.height; text: r.label; color: r.on == 3 ? #ef806c : #8b929a; font-size: 15.6px; vertical-alignment: center; wrap: word-wrap; overflow: elide; }
        }
    }
}
