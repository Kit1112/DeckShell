// /routes/media/grid - screenshots grid (3 columns of 335x188 css cards, pitch 342.5 x 196; ledger media/grid). Cards come from src/screens/media.rs
// (screenshot files under Steam userdata/<acct>/760/remote/<appid>/screenshots). Empty state when there are none.
import { Tokens } from "../tokens.slint";
import { Shell } from "../shell.slint";
import { Page } from "../widgets/page.slint";
import { Icon, Icons } from "../widgets/icon.slint";
import { GPageRow, GPageRows } from "../generated/settings/rows.slint";

export global MediaState {
    in property <string> title;
    in property <string> empty-text;   // NoContentAvailable
    in property <[GPageRow]> cards;
    in property <int> focus: -1;
    in-out property <length> vy;
    in property <length> content-h: 600px;
    in property <string> wrap-pad: "B,X,Y,FOCUS,keyboard";
    callback activated(int);
    callback entered();
    // viewer (A on a card; View Media in Fullscreen theme: header slides away, media fills the window)
    in property <bool> viewer-open;
    in property <image> viewer-img;
    in property <bool> viewer-has;
    in property <string> viewer-title;
    in property <string> viewer-sub;
    in property <[string]> viewer-actions: [];
    in property <int> viewer-focus;
    in property <string> viewer-note;
    // «Отправить на телефон» status panel: 0 hidden, 1 busy, 2 sent, 3 failed, 4 info. `phone-stage`: 0 check, 1 export, 2 upload, 3 done.
    in property <int> phone-tone: 0;
    in property <int> phone-stage: 0;
    in property <string> phone-text;
    callback viewer-action(int);
    callback viewer-close();
    // active filters line under the header
    in property <string> filter-text;
    in property <bool> selecting;
}

export component MediaScreen inherits Page {
    shown: Shell.page == 5;
    changed shown => { if (self.shown) { MediaState.entered(); } }
    Rectangle { y: 0px; height: Tokens.top-lib-h + 70px; background: @linear-gradient(180deg, #000000a0 0%, #00000000 100%); }
    if MediaState.cards.length == 0: Icon { x: (root.width - self.width) / 2; y: 250px; src: Icons.media; s: 96px; c: Tokens.text-dim; }
    if MediaState.cards.length == 0: Text { y: 370px; width: root.width; horizontal-alignment: center; text: MediaState.title; color: Tokens.text; font-size: 26px; font-weight: 800; }
    if MediaState.cards.length == 0: Text { y: 410px; width: root.width; horizontal-alignment: center; text: MediaState.empty-text; color: Tokens.text-dim; font-size: 18px; }
    // Grid viewport: from under the header gradient down to the footer hint row (no reserved plate).
    Rectangle { x: 0px; y: 47.94px; width: root.width; height: max(0px, root.height - Tokens.footer-h - 47.94px); accessible-role: button; accessible-description: "button||" + MediaState.wrap-pad; }
    Rectangle { x: 0px; y: 47.94px; width: root.width; height: max(0px, root.height - Tokens.footer-h - 47.94px); clip: true;
        Flickable {
            width: parent.width; height: parent.height; content-width: parent.width; content-height: MediaState.content-h; content-y <=> MediaState.vy;
            GPageRows { x: 0px; y: -47.94px; width: parent.width; height: MediaState.content-h; rows: MediaState.cards; sel: MediaState.focus; active: root.shown;
                activated(i) => { MediaState.activated(i); } }
            if MediaState.selecting: Rectangle {
                y: -47.94px; width: parent.width; height: MediaState.content-h;
                for card in MediaState.cards: Rectangle {
                    visible: card.kind == 8;
                    x: card.x + card.w - 40px; y: card.y + 10px; width: 30px; height: 30px;
                    border-radius: 4px; border-width: 2px;
                    border-color: card.on == 1 ? Tokens.accent : #ffffffcc;
                    background: card.on == 1 ? Tokens.accent : #0e141bcc;
                    if card.on == 1: Icon { x: 5px; y: 5px; src: Icons.checkmark; s: 20px; c: #ffffff; }
                }
            }
        }
    }
    if MediaState.filter-text != "": Text { x: 12px; y: Tokens.top-lib-h + 4px; width: root.width - 24px; horizontal-alignment: center; overflow: elide; text: MediaState.filter-text; color: Tokens.text-dim; font-size: 15px; font-weight: 700; }
    // fullscreen viewer
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        opacity: MediaState.viewer-open ? 1 : 0; visible: self.opacity > 0.01;
        animate opacity { duration: 500ms; easing: ease-in-out; }
        background: #000000;
        TouchArea { clicked => { } }
        if MediaState.viewer-has: Image { x: 0px; y: 0px; width: parent.width; height: parent.height; source: MediaState.viewer-img; image-fit: contain; }
        if !MediaState.viewer-has: Icon { x: (root.width - self.width) / 2; y: root.height / 2 - 60px; src: Icons.media; s: 96px; c: Tokens.text-dim; }
        Rectangle { y: 0px; height: 110px; background: @linear-gradient(180deg, #000000b0 0%, #00000000 100%); }
        Text { x: 36px; y: 22px; width: parent.width - 72px; text: MediaState.viewer-title; color: #ffffff; font-size: 24px; font-weight: 800; overflow: elide; }
        Text { x: 36px; y: 56px; width: parent.width - 72px; text: MediaState.viewer-sub; color: #dcdedf; font-size: 15px; overflow: elide; }
        Rectangle { y: parent.height - 190px; height: 190px; background: @linear-gradient(180deg, #00000000 0%, #000000c0 100%); }
        Text { x: 0px; y: parent.height - 150px; width: parent.width; horizontal-alignment: center; text: MediaState.viewer-note; color: #ffd37a; font-size: 15px; font-weight: 700; }
        // Phone send status: visible from the press on (same frame), replaced by the outcome text. Stages: check, export, upload.
        if MediaState.phone-tone != 0: Rectangle {
            x: 36px; y: parent.height - 180px; width: parent.width - 72px; height: 64px;
            background: #000000d8; border-radius: 8px;
            Text { x: 16px; y: 8px; width: parent.width - 32px; height: 40px; vertical-alignment: top; wrap: word-wrap; overflow: elide;
                text: MediaState.phone-text; font-size: 16px; font-weight: 700;
                color: MediaState.phone-tone == 2 ? #c8f5c0 : MediaState.phone-tone == 3 ? #ff9a8a : #ffffff; }
            if MediaState.phone-tone == 1 || MediaState.phone-tone == 2: Rectangle {
                x: 16px; y: 52px; width: parent.width - 32px; height: 6px;
                for v[k] in [0, 1, 2]: Rectangle {
                    x: k * ((parent.width - 8px) / 3 + 4px); width: (parent.width - 8px) / 3; height: 6px; border-radius: 3px;
                    background: MediaState.phone-tone == 2 || k < MediaState.phone-stage ? #c8f5c0 : (k == MediaState.phone-stage ? #ffd37a : #ffffff30);
                    animate background { duration: 200ms; }
                }
            }
        }
        HorizontalLayout {
            x: 0px; y: parent.height - 110px; width: parent.width; height: 48px; alignment: center; spacing: 14px;
            for a[i] in MediaState.viewer-actions: Rectangle {
                width: at.preferred-width + 48px; height: 48px; border-radius: 24px;
                background: MediaState.viewer-focus == i ? #ffffff : #ffffff30;
                animate background { duration: 100ms; }
                at := Text { text: a.to-uppercase(); color: MediaState.viewer-focus == i ? #23262e : #ffffff; font-size: 15px; font-weight: 700; vertical-alignment: center; horizontal-alignment: center; }
                TouchArea { clicked => { MediaState.viewer-action(i); } }
            }
        }
    }
}
