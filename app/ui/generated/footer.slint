// GENERATED by tools/compile-ui from the Steam dump (#Footer). Do not edit.
import { Hint } from "../widgets/types.slint";
import { FooterState } from "../widgets/footer.slint";
import { GStyle } from "style.slint";

// One hint chip: padding 6.25px 10px css, glyph 25x25, label margin-left 8, radius 7.5px; clickable (touch/mouse).
// Controller glyph (Hint.has-icon) is drawn as an image; without glyph art a text keycap is drawn (keyboard fallback, as widgets/footer.slint).
export component GKeyHint inherits Rectangle {
    in property <Hint> hint;
    callback clicked;
    height: 52.5px;
    width: 12px + icon.width + 12px + lab.preferred-width + 12px;
    border-radius: 9px;
    background: ta.pressed ? #ffffff26 : transparent;
    animate background { duration: 50ms; easing: cubic-bezier(0, 0, 0.58, 1); }
    icon := Rectangle {
        x: 12px; y: 7.5px;
        width: root.hint.has-icon ? 37.5px : (root.hint.kind == 0 ? max(37.5px, g.preferred-width + 2 * 12.38px) : (root.hint.kind == 2 ? 60px : (root.hint.kind == 3 ? 92px : 37.5px)));
        height: root.hint.has-icon ? 37.5px : (root.hint.kind == 3 ? 33px : 37.5px);
        border-radius: root.hint.kind == 0 ? 3.63px : self.height / 2;
        background: root.hint.has-icon ? transparent : #ffffff;
        if root.hint.has-icon: Image { width: parent.width; height: parent.height; source: root.hint.icon; image-fit: contain; }
        g := Text { visible: !root.hint.has-icon; text: root.hint.glyph; color: #23262e; font-size: 18px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
    }
    lab := Text { x: 12px + icon.width + 12px; y: 9.76px; height: 32.99px; text: root.hint.label.to-uppercase(); font-family: GStyle.loc-font; color: #ffffff; font-size: 18px; font-weight: 700; letter-spacing: GStyle.loc-ls-k * 0.75px; vertical-alignment: center; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

// Footer bar (41.82 css high, bg rgba(0, 0, 0, 0.5); backdrop blur(125px) is not reproduced). The window places it at y = height - self.height.
// Left hint = FooterState.left-hint, right hints (contiguous, right-aligned) = FooterState.hints.
// clicked(index): index -1 = left hint (Steam menu), 0.. = FooterState.hints[index]; wire to the same actions as the gamepad buttons.
export component GFooterBar inherits Rectangle {
    callback clicked(int);
    in property <int> top-row-hints;
    height: top-row-hints > 0 ? 114px : FooterState.bar-height;
    background: #00000080;
    GKeyHint { x: 28.4px; y: 5.75px; hint: FooterState.left-hint; clicked => { root.clicked(-1); } }
    if root.top-row-hints > 0: HorizontalLayout {
        x: root.width - self.width - 28.41px; y: 5.75px; width: self.preferred-width; height: 52.5px; spacing: 0px;
        for h[i] in FooterState.hints: Rectangle { width: i < root.top-row-hints ? top-chip.width : 0px; visible: i < root.top-row-hints; top-chip := GKeyHint { hint: h; clicked => { root.clicked(i); } } }
    }
    HorizontalLayout {
        x: root.width - self.width - 28.41px; y: 5.75px + (root.top-row-hints > 0 ? 52px : 0px); width: self.preferred-width; height: 52.5px; spacing: 0px;
        for h[i] in FooterState.hints: Rectangle { width: i >= root.top-row-hints ? bottom-chip.width : 0px; visible: i >= root.top-row-hints; bottom-chip := GKeyHint { hint: h; clicked => { root.clicked(i); } } }
    }
}
