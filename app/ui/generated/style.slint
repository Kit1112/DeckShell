// GENERATED by tools/compile-ui/compile.mjs from docs/cdp (fonts-home.json: Cyrillic text falls back to DejaVu Sans in Steam). DO NOT EDIT BY HAND - rerun: node tools/compile-ui/compile.mjs
// Localized UI strings (Russian etc.) are rendered by Steam with DejaVu Sans (Motiva has no Cyrillic; Slint's own fallback picks Noto Sans, which is narrower).
// Set loc-font to "" for Latin locales to use the default (Motiva Sans).
export global GStyle {
    in property <string> loc-font: "DejaVu Sans";
    // Scale of the CSS letter-spacing for localized labels (1 = as in CSS). Slint's unhinted DejaVu advances are ~2% wider than Chrome's.
    in property <float> loc-ls-k: 1;
}
