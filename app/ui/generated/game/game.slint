// Play bar [Clean Gameview: transparent]: outer #0e141b40 from y 547.5 css to the bottom, inner #0e141b54 79.97 css high.
// Primary button: unfocused = base grey rgba(220,222,223,.17) (node QsZd..), focused (gpfocus) = solid accent (green #59bf40 play / blue #1a9fff install), no outline.
export component GGameBar inherits Rectangle {
    in property <string> primary;
    in property <bool> playable;          // green play (Играть/Возобновить) vs blue install/update
    in property <int> fidx: -1;          // 0 primary, 1 controller, 2 gear, -1 none (focus in tabs / content)
    in property <string> k1; in property <string> v1;
    in property <string> k2; in property <string> v2;
    in property <string> k3; in property <string> v3;
    in property <string> meta1; in property <string> meta2; in property <string> meta3; in property <string> meta-button; in property <string> meta-ctrl; in property <string> meta-gear;
    callback clicked(int);
    Rectangle { y: 657px; height: root.height - self.y; background: #0e141b40; }
    Rectangle { y: 657px; height: 95.96px; background: #0e141b54; }
    Rectangle {
        x: 35.86px; y: 676.19px; width: 252px; height: 57.59px; border-radius: 2.4px;
        background: #dcdedf2b;
        Rectangle { border-radius: parent.border-radius; background: root.fidx == 0 ? (root.playable ? #59bf40 : #1a9fff) : transparent;
            animate background { duration: 200ms; easing: cubic-bezier(0, 0, 0.58, 1); } }
        Icon { x: 19.19px; y: 14.39px; src: root.playable ? Icons.play : Icons.downloads; s: 28.8px; }
        Text { x: 67.18px; height: parent.height; text: root.primary; font-family: GStyle.loc-font; color: #ffffff; font-size: 19.2px; font-weight: 500; vertical-alignment: center; }
        accessible-role: button; accessible-label: root.primary; accessible-description: root.meta-button;
        TouchArea { clicked => { root.clicked(0); } }
    }
    HorizontalLayout {
        x: 307.04px; y: 677.39px; height: 50.39px; spacing: 24px; alignment: start;
        for k[i] in [root.k1, root.k2, root.k3]: VerticalLayout {
            visible: k != ""; width: k == "" ? 0px : self.preferred-width;
            Text { height: 26.39px; text: k; font-family: GStyle.loc-font; color: #ffffffb3; font-size: 14.4px; font-weight: 700; letter-spacing: GStyle.loc-ls-k * 0.6px; vertical-alignment: center; }
            Text { height: 24px; text: i == 0 ? root.v1 : i == 1 ? root.v2 : root.v3; font-family: GStyle.loc-font; color: #ffffff; font-size: 19.2px; font-weight: 500; vertical-alignment: center; }
        }
    }
    for ic[i] in [0, 1]: Rectangle {
        x: root.width - 35.87px - 57.59px - (1 - i) * 69.59px; y: 676.19px; width: 57.59px; height: 57.59px; border-radius: 2.4px;
        background: root.fidx == i + 1 ? #dcdedf : #acb2c924;
        animate background { duration: 120ms; }
        accessible-role: button; accessible-description: i == 0 ? root.meta-ctrl : root.meta-gear;
        Icon { x: 14.39px; y: 14.39px; src: i == 0 ? Icons.controller : Icons.settings; s: 28.8px; c: root.fidx == i + 1 ? #23262e : #dcdedf; }
        TouchArea { clicked => { root.clicked(i + 1); } }
    }
}

// Logo: 25.99/407.49 css, 120 css high, width follows the image aspect (contain).
export component GGameLogo inherits Rectangle {
    in property <image> source;
    in property <string> name;
    in property <bool> has-art;
    if root.has-art: Image { x: 31.19px; y: 488.99px; height: 144px; width: self.height * root.source.width / max(1, root.source.height); source: root.source; image-fit: contain; }
    if !root.has-art: Text { x: 31.19px; y: 488.99px; width: 1218.62px; height: 144px; text: root.name; color: #fff; font-size: 40px; font-weight: 800; overflow: elide; wrap: word-wrap; vertical-alignment: bottom; }
}

// plugin:hltb-for-deck (style "clean": absolute, bar alpha .5, no border), data = HLTB search (context/archive/docs/decky-plugins.md); rows hidden when "--".
export struct GHltbRow { time: string, label: string }
export component GGameHltb inherits Rectangle {
    in property <length> page-w;
    in property <[GHltbRow]> rows;
    in property <string> meta;
    visible: root.rows.length > 0;
    x: root.page-w - 35.86px - self.width; y: 216.46px;
    width: 84px + 157.7px; height: 12px + 52px * root.rows.length + 12px;
    background: #0e141b80;
    accessible-role: list; accessible-label: "HLTB"; accessible-description: root.meta;
    VerticalLayout { padding: 12px; padding-left: 42px; padding-right: 42px; alignment: start;
        for r in root.rows: VerticalLayout { height: 52px;
            Text { height: 35px; text: r.time; color: #dcdedf; font-size: 24px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            Text { height: 17px; text: r.label.to-uppercase(); font-family: GStyle.loc-font; color: #dcdedf; font-size: 12px; font-weight: 400; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}

// plugin:playcount-decky badge: "<dot> N Online", pill #cfb53b, 50 css from the top, 20 css from the right.
export component GGameBadge inherits Rectangle {
    in property <length> page-w;
    in property <string> text;       // "23,842 Online"
    in property <string> meta;
    in property <bool> pressed: false;
    callback clicked();
    visible: root.text != "";
    x: root.page-w - 24px - self.width; y: 60px;
    height: 30.19px; width: 43.2px + lbl.preferred-width;
    border-radius: 14.4px; background: #cfb53b;
    drop-shadow-color: #00000033; drop-shadow-offset-y: 2.4px; drop-shadow-blur: 4.8px;
    accessible-role: button; accessible-label: root.text; accessible-description: root.meta;
    Rectangle { x: 9.6px; y: (parent.height - 16.8px) / 2; width: 16.8px; height: self.width; border-radius: self.width / 2; background: #59bf40; }
    lbl := Text { x: 33.6px; height: parent.height; text: root.text; color: #ffffff; font-size: 14.4px; font-weight: 400; vertical-alignment: center; }
    TouchArea { clicked => { root.clicked(); } }
}

// Tab pills (АКТИВНОСТЬ / ЛИЧНОЕ / СООБЩЕСТВО / ОБ ИГРЕ): row 57.96 css high at page y 627.47 css, group centred ("24 css" spacers), pill = padding 6/16/6/16 css, radius 64.
// selected: rgba(255,255,255,.15) + white text; focused (gpfocus, row scrolled to the top): white pill + #23262e text + shadow rgba(0, 0, 0, 0.32) 0px 3px 6px 0px; bumper glyph chips left/right of the group appear while focused.
export component GGameTabs inherits Rectangle {
    in property <[string]> labels;
    in property <[string]> tokens;
    in property <int> selected: 0;
    in property <bool> focused: false;
    in property <string> meta;
    in property <string> meta-row;
    callback clicked(int);
    height: 69.55px;
    // row||1 (strip inside the page padding, L1/R1) and row||2 (the centred pill group, + D-pad)
    Rectangle { x: 35.86px; width: root.width - 71.71px; height: parent.height; accessible-role: groupbox; accessible-description: "row||L1,R1"; }
    Rectangle { x: (root.width - grp.preferred-width) / 2; width: grp.preferred-width; height: parent.height; accessible-role: groupbox; accessible-description: root.meta-row; }
    grp := HorizontalLayout { alignment: center; spacing: 2.4px; y: 14.4px; height: 40.76px;
        Rectangle { width: 28.8px; }
        for l[i] in root.labels: Rectangle {
            border-radius: 76.8px; clip: false;
            background: root.focused && i == root.selected ? #ffffff : i == root.selected ? #ffffff26 : transparent;
            drop-shadow-color: root.focused && i == root.selected ? #00000052 : transparent; drop-shadow-offset-y: 3.6px; drop-shadow-blur: 7.2px;
            animate background { duration: 100ms; }
            accessible-role: tab; accessible-label: l; accessible-description: "tab|" + root.tokens[i] + "|A,L1,R1,FOCUS,BLUR,touch,mouse";
            HorizontalLayout { padding-left: 19.2px; padding-right: 19.2px; padding-top: 7.2px; padding-bottom: 7.2px;
                Text { text: l.to-uppercase(); font-family: GStyle.loc-font; font-size: 14.4px; font-weight: 700; letter-spacing: GStyle.loc-ls-k * 0.6px; vertical-alignment: center;
                       color: root.focused && i == root.selected ? #23262e : i == root.selected ? #ffffff : #dcdedf; } }
            TouchArea { clicked => { root.clicked(i); } }
        }
        Rectangle { width: 28.8px; }
    }
    if root.focused: Rectangle { x: 0px; y: 22.16px; width: 33px; height: 25.2px; border-radius: 2.08px; background: #fff;
        Text { text: "L1"; color: #23262e; font-size: 12.48px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
    if root.focused: Rectangle { x: root.width - 67.76px; y: 22.16px; width: 31.91px; height: 25.2px; border-radius: 2.08px; background: #fff;
        Text { text: "R1"; color: #23262e; font-size: 12.48px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
}
