    out property <length> holder-w: 36px;
    out property <length> header-h: 36.06px;
}

// Tab pill row (TabMaster tabs when configured): states selected rgba(255, 255, 255, 0.15) / normal rgb(220, 222, 223) / focused white + #23262e text + shadow, 100 ms.
// "No Game Count" theme: no count badge.
export component GLibPill inherits Rectangle {
    in property <[string]> tabs;
    in property <int> selected;
    in property <bool> focused;
    callback activated(int);
    y: 77.99px; height: 50.96px;
    // rows of the Steam tree around the pill: tab bar row (1007.73 css wide) and the [holder][tabs][holder] row
    Rectangle { x: 44.82px; y: -17.99px; width: root.width - 2 * 44.82px; height: 86.94px;
        accessible-role: groupbox; accessible-label: root.tabs[root.selected]; accessible-description: "row||L1,R1,FOCUS,BLUR"; }
    Rectangle { x: (root.width - hl.preferred-width) / 2; y: -17.99px; width: hl.preferred-width; height: 86.94px;
        accessible-role: groupbox; accessible-label: root.tabs[root.selected]; accessible-description: "row||L1,R1,DPAD_LEFT,DPAD_RIGHT,FOCUS,BLUR"; }
    hl := HorizontalLayout {
        height: parent.height; alignment: center; spacing: 2.85px;
        Rectangle { width: 36px; }
        for t[i] in root.tabs: Rectangle {
            width: 24px + lab.preferred-width + 24px;
            pill := Rectangle {
                height: parent.height; width: parent.width; border-radius: 76.8px;
                property <bool> foc: root.focused && root.selected == i;
                background: foc ? #ffffff : (root.selected == i ? #ffffff26 : #00000000);
                drop-shadow-color: foc ? #00000052 : #00000000; drop-shadow-offset-y: foc ? 3.6px : 0px; drop-shadow-blur: foc ? 7.2px : 0px;
                animate background, drop-shadow-color, drop-shadow-offset-y, drop-shadow-blur { duration: 100ms; easing: ease; }
            }
            lab := Text { x: 24px; height: parent.height; text: t.to-uppercase(); font-family: GStyle.loc-font;
                          color: pill.foc ? #23262e : (root.selected == i ? #ffffff : #dcdedf);
                          font-size: 18px; font-weight: 700; letter-spacing: GStyle.loc-ls-k * 0.75px; vertical-alignment: center;
                          animate color { duration: 100ms; easing: ease; } }
            accessible-role: tab; accessible-label: t; accessible-description: "tab||A,B,X,Y,START,L1,R1,DPAD_LEFT,DPAD_RIGHT,DPAD_DOWN,FOCUS,BLUR,touch,mouse";
            TouchArea { clicked => { root.activated(i); } }
        }
        Rectangle { width: 36px; }
    }
}

// Uninstalled Game Icon theme: 24 css circle, 4/4 css from the tile corner, hidden while the tile has focus.
export component GLibBadge inherits Rectangle {
    in property <bool> tile-focused;
    x: GLib.tile-w - 42px; y: GLib.tile-h - 42px; width: 36px; height: 36px;
    border-radius: 30px; background: #1b1e24e6; opacity: root.tile-focused ? 0 : 1; visible: self.opacity > 0.01;
    animate opacity { duration: 300ms; }
    Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; src: Icons.downloads; s: 24px; }
}

// Library Move Extra Info theme: pill under the tile (left 0 css, 5 css when focused, bottom -10 css, 20 css high, radius 10).
export component GLibCaption inherits Rectangle {
    in property <string> text;
    in property <bool> tile-focused;
    x: root.tile-focused ? 7.5px : 0px; y: GLib.tile-h - 30px - (-15px);
    width: cap.preferred-width + 30px; height: 30px; border-radius: 15px; background: #c3ccd8; z: 13;
    visible: root.text != "";
    cap := Text { x: 15px; height: parent.height; text: root.text; color: #0e141b; font-size: 18px; font-family: GStyle.loc-font; vertical-alignment: center; }
}

// Section header (sort by hours / last played ...): text style follows the library section titles (dump has none: home h2 18 css/500 white at the grid padding).
export component GLibHeader inherits Rectangle {
    in property <string> text;
    Text { x: 56.84px; y: 0px; height: 39px; text: root.text; font-family: GStyle.loc-font; color: #ffffff; font-size: 27px; font-weight: 500; vertical-alignment: center; }
}

// Dialog menu (tile context menu / options / sort / TabMaster): items 47.99 css high, bg #23262e, text #b8bcbf, first (primary) item #59bf40, 2 css black separators, drop-shadow 0 0 8 .5.
// flags[i]: bits 0-1 kind (0 normal, 1 primary green, 2 primary blue/install), bit 2 (4) separator above, bit 3 (8) arrow, bit 4 (16) disabled
export component GLibMenu inherits Rectangle {
    in property <[string]> labels;
    in property <[int]> flags;
    in property <int> focused-idx: 0;
    in property <string> title;
    in property <int> current: -1;
    in property <string> role: "list-item";
    in property <length> pad-top: 0px;       // tile dialog: ledger dialog box starts 15 css above the first item and ends 40 css below the last
    in property <length> pad-bottom: 0px;
    callback activated(int);
    background: #00000000;
    height: lay.preferred-height + root.pad-top + root.pad-bottom;
    drop-shadow-color: #00000080; drop-shadow-blur: 12px;
    accessible-role: groupbox; accessible-label: root.title; accessible-description: "dialog||A,B,Y,DPAD_UP,DPAD_DOWN,DPAD_LEFT,touch,mouse";
    lay := VerticalLayout {
        y: root.pad-top; height: self.preferred-height;
        alignment: start;
        if root.title != "": Rectangle { height: 71.99px; background: #23262e;
            Text { x: 21px; height: parent.height; text: root.title; color: #ffffff; font-size: 24px; font-weight: 800; font-family: GStyle.loc-font; vertical-alignment: center; } }
        for lbl[i] in root.labels: Rectangle {
            property <int> fl: root.flags[i];
            property <int> kind: Math.mod(fl, 4);
            property <bool> sep: Math.mod(Math.floor(fl / 4), 2) == 1;
            property <bool> arrow: Math.mod(Math.floor(fl / 8), 2) == 1;
            property <bool> dis: Math.mod(Math.floor(fl / 16), 2) == 1;
            height: 71.99px + (sep ? 3px : 0px);
            if sep: Rectangle { y: 0px; height: 3px; background: #000000; }
            Rectangle {
                y: sep ? 3px : 0px; height: 71.99px;
                property <bool> f: root.focused-idx == i;
                accessible-role: list-item; accessible-label: lbl; accessible-description: root.role + "||A,B,DPAD_UP,DPAD_DOWN,FOCUS,BLUR,touch,mouse" + (arrow ? ",DPAD_RIGHT" : "");
                background: kind == 1 ? #59bf40 : (kind == 2 ? #1a9fff : (f ? #3d4450 : #23262e));
                animate background { duration: 100ms; }
                Text { x: 21px; width: parent.width - 57px; height: parent.height; text: lbl; font-family: GStyle.loc-font;
                       color: (kind != 0 || f) ? #ffffff : #b8bcbf; font-size: 24px; font-weight: (root.current == i || kind != 0) ? 700 : 400; vertical-alignment: center; overflow: elide; opacity: dis ? 0.5 : 1; }
                if arrow: Text { x: parent.width - 45px; height: parent.height; text: ">"; color: #b8bcbf; font-size: 24px; vertical-alignment: center; }
                if root.current == i: Rectangle { x: parent.width - 39px; y: (parent.height - self.height) / 2; width: 15px; height: 15px; border-radius: 7.5px; background: #1a9fff; }
                TouchArea { clicked => { root.activated(i); } }
            }
        }
    }
}
