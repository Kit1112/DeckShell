// GENERATED by tools/compile-ui/pages.mjs from docs/parity/ledger.json + docs/cdp/behavior/settings-controls.json + props dump styles. DO NOT EDIT BY HAND.
import { Tokens } from "../../tokens.slint";
import { Toggle } from "../../widgets/toggle.slint";
import { Icon, Icons } from "../../widgets/icon.slint";

// One element of a Steam settings-like page. Kinds: 0 semantic only, 1 label row, 2 toggle, 3 checkbox, 4 button, 5 text field, 6 image, 7 osk key, 8 card, 9 tab pill, 10 list card, 11 title text, 12 dim text (sub "r" = right aligned), 13 round icon button (on: 1 pause / 0 load), 14 section header.
export struct GPageRow { kind: int, role: string, token: string, label: string, desc: string, x: length, y: length, w: length, h: length, pad: string, on: int, img: image, has-img: bool, sub: string, shift: string, ptr: bool, fcs: bool }

export component GPageRows inherits Rectangle {
    in property <[GPageRow]> rows;
    in property <int> sel: -1;
    in property <bool> active: true;
    in property <bool> touch-enabled: true;
    callback activated(int);
    callback hovered(int);
    for r[i] in root.rows: Rectangle {
        x: r.x; y: r.y; width: r.w; height: r.h;
        // Wrapped text must stay inside its captured row.
        clip: r.kind == 1 || r.kind == 12;
        property <bool> foc: root.active && root.sel == i;
        accessible-role: button; // real role comes from the description (ledger role)
        accessible-label: r.kind == 1 ? (r.label != "" ? r.label : r.sub) : (r.kind == 7 && r.shift != "") ? r.shift + " " + r.label : r.label;
        property <bool> available: (r.kind != 2 && r.kind != 3) || r.on >= 0;
        accessible-description: r.role + "|" + r.token + "|" + (self.available ? r.pad : "unavailable");
        accessible-enabled: self.available;
        accessible-checkable: (r.kind == 2 || r.kind == 3) && self.available;
        accessible-checked: r.on == 1;
        // 1: label + description
        if r.kind == 1: Text { x: 0px; y: 0px; width: parent.width - 120px; text: r.label; color: #dcdedf; font-size: 19.2px; font-weight: 400; overflow: elide; }
        if r.kind == 1 && r.desc != "": Text { x: 0px; y: 27px; width: parent.width - 150px; height: max(0px, parent.height - 27px); vertical-alignment: top; text: r.desc; color: #8b929a; font-size: 16.8px; wrap: word-wrap; }
        // 2: toggle, 3: checkbox
        if r.kind == 2: Toggle { x: parent.width - self.width; y: (parent.height - self.height) / 2; on: r.on; focused: foc; }
        if r.kind == 3: Rectangle {
            opacity: r.on < 0 ? 0.35 : 1;
            if r.on < 0: Text { text: "—"; color: Tokens.text; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
            width: parent.width; height: parent.height; border-radius: 3px; background: r.on == 1 ? Tokens.accent : #ffffff1a;
            border-width: foc ? 2px : 0px; border-color: #ffffff;
            if r.on == 1: Text { text: "✓"; color: #ffffff; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; width: parent.width; height: parent.height; }
        }
        // 4: button / drop-down / link
        if r.kind == 4: Rectangle {
            width: parent.width; height: parent.height; border-radius: 2px;
            background: foc ? #ffffff : (r.fcs ? #ffffff26 : transparent);
            animate background { duration: Tokens.dur-btn; easing: ease-out; }
            Text { width: parent.width; height: parent.height; text: r.label; color: foc ? #0e141b : #dcdedf; font-size: 19.2px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        // Storage sort modal option, left aligned like Steam's action menu.
        if r.kind == 26: Rectangle {
            width: parent.width; height: parent.height; background: foc ? #ffffff : transparent;
            Text { x: 20px; width: parent.width - 40px; height: parent.height; text: r.label; color: foc ? #0e141b : #dcdedf; font-size: 24px; vertical-alignment: center; overflow: elide; }
        }
        // 5: text field
        if r.kind == 5: Rectangle {
            width: parent.width; height: parent.height; background: foc ? #ffffff : #ffffff1a;
            Text { x: 19px; width: parent.width - 38px; height: parent.height; text: r.label; color: foc ? #0e141b : #8b929a; font-size: 19.2px; vertical-alignment: center; overflow: elide; }
        }
        // 6/8: image + caption
        if r.kind == 6 || r.kind == 8: Rectangle {
            width: parent.width; height: parent.height; background: #1b2838; clip: true;
            if r.has-img: Image { width: parent.width; height: parent.height; source: r.img; image-fit: cover; }
        }
        if r.kind == 8: Rectangle { y: parent.height - 24px; width: parent.width; height: 24px; background: #0e141bcc; Text { x: 8px; width: parent.width - 16px; height: parent.height; text: r.label; color: #dcdedf; font-size: 14px; vertical-alignment: center; overflow: elide; } }
        if r.kind == 8 && foc: Rectangle { width: parent.width; height: parent.height; border-width: 2.4px; border-color: #ffffffcc; }
        // 7: on-screen keyboard key (dark cell, 1 css px gap; special keys (sub "s") darker with the label bottom-left; focused = solid white, dark text)
        if r.kind == 7: Rectangle {
            x: 1.2px; y: 1.2px; width: parent.width - 2.4px; height: parent.height - 2.4px;
            background: foc ? #ffffff : (r.sub == "#sp" ? #05080b : (r.on == 1 ? #2a3340 : #0e141b));
            if r.sub != "#sp" && r.shift != "": Text { x: 0px; y: 3px; width: parent.width; text: r.shift; color: foc ? #0e141b : #8b929a; font-size: 14px; horizontal-alignment: center; }
            if r.sub != "#sp": Text { width: parent.width; height: parent.height; y: r.shift != "" ? 8px : 0px; text: r.label; color: foc ? #0e141b : #acb2b8; font-size: 19.2px; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
            if r.sub == "#sp": Text { x: 10px; y: parent.height - 30px; width: parent.width - 20px; height: 24px; text: r.label; color: foc ? #0e141b : #acb2b8; font-size: 16.8px; vertical-alignment: center; }
            if r.sub == "#sp" && r.desc != "": Text { x: 10px; y: parent.height - 30px; width: parent.width - 20px; height: 24px; text: r.desc; color: foc ? #0e141b : #8b929a; font-size: 14px; vertical-alignment: center; horizontal-alignment: right; }
        }
        // 10..14: download queue / generic text (list card bg, title, dim text, icon button, section header)
        if r.kind == 10: Rectangle { width: parent.width; height: parent.height; border-radius: 4px; background: foc ? #ffffff1a : transparent; animate background { duration: Tokens.dur-pill; } }
        if r.kind == 11 && foc: Rectangle { width: parent.width; height: parent.height; background: #ffffff26; border-width: 2px; border-color: #ffffff; }
        if r.kind == 11: Text { width: parent.width; height: parent.height; text: r.label; color: #ffffff; font-size: 19.2px; font-weight: 500; vertical-alignment: center; overflow: elide; }
        if r.kind == 12: Text { width: parent.width; height: parent.height; text: r.label; color: #8b929a; font-size: 16.8px; font-weight: r.sub == "legend" ? 700 : 400; vertical-alignment: center; overflow: elide; horizontal-alignment: r.sub == "r" ? TextHorizontalAlignment.right : TextHorizontalAlignment.left; }
        if r.kind == 13: Rectangle {
            width: parent.width; height: parent.height; border-radius: 2px; background: foc ? #ffffff : #ffffff26;
            Icon { x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; src: r.on == 1 ? Icons.pause : Icons.downloads; s: 20px; c: foc ? #0e141b : #dcdedf; }
        }
        if r.kind == 14: Text { x: 18px; width: parent.width - 18px; height: parent.height; text: r.label; color: #ffffff; font-size: 19.2px; font-weight: 700; vertical-alignment: center; }
        // Storage capacity: used and free portions derived from Steam's values.
        if r.kind == 16 || r.kind == 17: Rectangle { x: r.sub == "last" ? -6px : 0px; width: parent.width + (r.sub == "first" || r.sub == "last" ? 6px : 0px); height: parent.height; border-radius: r.sub == "dot" ? 5px : (r.sub == "" ? 0px : 6px); background: r.kind == 16 ? #1a9fff : #ffffff26; }
        if r.kind >= 18 && r.kind <= 23: Rectangle { x: r.sub == "last" ? -6px : 0px; width: parent.width + (r.sub == "first" || r.sub == "last" ? 6px : 0px); height: parent.height; border-radius: r.sub == "dot" ? 5px : (r.sub == "" ? 0px : 6px); background: r.kind == 18 ? #1a9fff : r.kind == 19 ? #5340a6 : r.kind == 20 ? #59bf40 : r.kind == 21 ? #ef806c : r.kind == 22 ? #ad66bb : #ffc82c; }
        if r.kind == 25: Rectangle { x: r.sub == "last" ? -6px : 0px; width: parent.width + (r.sub == "first" || r.sub == "last" ? 6px : 0px); height: parent.height; border-radius: r.sub == "dot" ? 5px : (r.sub == "" ? 0px : 6px); background: #287b46; }
        // Storage device card: label and capacity belong to this device.
        if r.kind == 24: Rectangle {
            width: parent.width; height: parent.height; border-radius: 25px;
            background: foc ? #60666e : (r.on == 1 ? #ffffff26 : transparent);
            if r.sub == "sd": Image { x: 14px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; source: Icons.sdcard; image-fit: contain; }
            if r.sub != "sd": Image { x: 14px; y: (parent.height - 20px) / 2; width: 20px; height: 20px; source: Icons.harddrive; image-fit: contain; }
            Text { x: 42px; y: 12px; width: parent.width - 50px; height: 24px; text: r.label; color: #ffffff; font-size: 18px; vertical-alignment: center; overflow: elide; }
            Text { x: 42px; y: 38px; width: parent.width - 50px; height: 24px; text: r.desc; color: foc ? #ffffff : #acb2b8; font-size: 15px; font-weight: 700; vertical-alignment: center; overflow: elide; }
        }
        // 15: search result caption (grid icon + token text under the image; focus ring around the image)
        if r.kind == 15: Rectangle {
            width: parent.width; height: parent.height;
            Rectangle { x: 0px; y: 7px; width: parent.width; height: 108px; border-width: foc ? 2.4px : 0px; border-color: #ffffffcc; }
            Rectangle { x: 6px; y: 128px; width: 8px; height: 8px; background: #8b929a; }
            Rectangle { x: 16px; y: 128px; width: 8px; height: 8px; background: #8b929a; }
            Rectangle { x: 6px; y: 138px; width: 8px; height: 8px; background: #8b929a; }
            Rectangle { x: 16px; y: 138px; width: 8px; height: 8px; background: #8b929a; }
            Text { x: 34px; y: 126px; width: parent.width - 34px; height: 22px; text: r.label; color: #8b929a; font-size: 16.8px; font-weight: 700; letter-spacing: 1px; vertical-alignment: center; overflow: elide; }
        }
        // 9: pill
        if r.kind == 9: Rectangle {
            width: parent.width; height: parent.height; border-radius: 64px; background: foc ? #ffffff : (r.on == 1 ? #ffffff26 : transparent);
            animate background { duration: Tokens.dur-pill; }
            Text { width: parent.width; height: parent.height; text: r.label; color: foc ? #23262e : (r.on == 1 ? #ffffff : #dcdedf); font-size: 14.4px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
        if r.kind >= 2 && r.ptr: TouchArea { enabled: parent.available; clicked => { root.activated(i); } }
    }
}
