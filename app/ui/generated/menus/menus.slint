// GENERATED by tools/compile-ui/compile-menus.mjs from docs/cdp (steam-menu.json, steam-menu-focus-library.json, qam.json, surfaces/qam-quick-settings.QuickAccess.dump.json, surfaces/states-qam-*.json). DO NOT EDIT BY HAND.
import { GStyle } from "../style.slint";
import { Icon } from "../../widgets/icon.slint";
import { Toggle } from "../../widgets/toggle.slint";

// ================================================================== geometry (device px = css x 1.2)
export global GMenuGeo {
    // Steam main menu popup 240x669 css: panel top 40 css, rows from 102.6 css, pitch 48 css
    out property <length> menu-w: 288px;
    out property <length> menu-top: 48px;
    out property <length> menu-row-y0: 123.12px;
    out property <length> menu-row-pitch: 57.6px;
    out property <length> menu-row-h: 57.59px;
    out property <duration> menu-slide: 300ms;
    out property <easing> menu-ease: cubic-bezier(0.16, 0.86, 0.43, 0.99);
    // QAM popup 854x588.33 css, visible part = left 347.99 css (rail 47.99 + content 300)
    out property <length> qam-w: 417.59px;
    out property <length> qam-rail-w: 57.59px;
    out property <length> qam-tab-y0: 161px;
    out property <length> qam-tab-h: 76.79px;
    out property <length> qam-content-x: 57.59px;
    out property <length> qam-content-w: 360px;
    out property <length> qam-title-h: 57.58px;
    out property <length> qam-content-y0: 76.78px;
    out property <length> qam-hdr-h: 35.99px;
    out property <length> qam-slider-h: 52.8px;
    out property <length> qam-toggle-h: 50.39px;
    out property <length> qam-btn-row-h: 72px;
    out property <length> qam-sep-h: 1.19px;
    out property <length> qam-gap: 28.8px;
    out property <length> qam-notch-h: 75.59px;
    out property <length> qam-tall-h: 96px;
    out property <length> qam-pad: 19.19px;
    out property <duration> qam-in: 300ms;
    out property <duration> qam-out: 200ms;
    out property <duration> qam-rail-scale: 320ms;
    out property <easing> qam-ease: cubic-bezier(0.17, 0.45, 0.14, 0.83);
}

// ================================================================== Steam main menu
export struct GMenuRow { label: string, icon: image, indent: bool, current: bool, meta: string }

// One row: 47.99 css high; current page = scale 1.1 about x=28.8 css + blue bar; focused = rgba(255,255,255,.1) bg + scale 1.1 (transform 320 ms cubic-bezier(0.17, 0.45, 0.14, 0.83)).
export component GMenuItem inherits Rectangle {
    in property <string> label;
    in property <image> icon;
    in property <bool> color-icon;
    in property <bool> indent;
    in property <bool> current;
    in property <bool> focused;
    in property <string> meta;
    callback clicked;
    callback hovered;
    height: 57.59px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.meta;
    property <bool> big: root.current || root.focused;
    // Steam flashes the focused row from 50% to 20% (current) or 30% to 10%.
    property <float> focus-alpha: root.current ? 0.5 : 0.3;
    states [ focused when root.focused: {
        focus-alpha: root.current ? 0.2 : 0.1;
        in { animate focus-alpha { duration: 500ms; easing: cubic-bezier(0.17, 0.45, 0.14, 0.83); } }
    } ]
    Rectangle {
        width: parent.width; height: parent.height;
        transform-scale: root.big ? 1.1 : 1.0;
        transform-origin: { x: 34.56px, y: self.height / 2 };
        animate transform-scale { duration: 320ms; easing: cubic-bezier(0.17, 0.45, 0.14, 0.83); }
        Rectangle {
            background: root.focused ? #ffffff.transparentize(1 - root.focus-alpha) : transparent;
        }
        if root.current: Rectangle { x: -3.59px; y: (parent.height - self.height) / 2; width: 12px; height: 28.79px; border-radius: 6.55px; background: #1a9fff; }
        Icon { x: 28.8px + (root.indent ? 38.4px : 0px); y: 16.8px; src: root.icon; s: 24px; tint: !root.color-icon; c: root.big ? #ffffff : #b8bcbf; }
        Text {
            x: 71.99px + (root.indent ? 38.4px : 0px); y: 0px; height: parent.height; text: root.label; vertical-alignment: center;
            font-family: GStyle.loc-font; font-size: 21.6px; font-weight: 400; color: root.big ? #ffffff : #b8bcbf;
        }
    }
    ta := TouchArea { clicked => { root.clicked(); } changed has-hover => { if (self.has-hover) { root.hovered(); } } }
}

// Whole popup content (background, rows, bottom shadow strip). The screen slides it (translateX -288px -> 0).
export component GSteamMenuPanel inherits Rectangle {
    in property <[GMenuRow]> rows;
    in property <int> cursor: -1;
    callback activated(int);
    width: 288px;
    background: #0e141b;
    clip: true;
    for m[i] in root.rows: GMenuItem {
        x: 0px; y: 123.12px + i * 57.6px; width: parent.width;
        label: m.label; icon: m.icon; indent: m.indent; current: m.current; meta: m.meta; focused: root.cursor == i;
        clicked => { root.activated(i); }
    }
    Rectangle {
        x: -16.8px; y: parent.height - 48px; width: 321.59px; height: 48px;
        drop-shadow-color: #00000040; drop-shadow-offset-y: -4.8px; drop-shadow-blur: 12px;
        background: #0e141b;
    }
}

// ================================================================== QAM building blocks (popup-local, content column 300 css wide)
// Rail: 5 tabs (notifications, friends, quick settings, performance, decky); tabs hidden by the user's "QAM Hide Tabs" theme are simply not passed.
export component GQamRail inherits Rectangle {
    in property <[image]> icons;
    in property <[string]> labels;
    in property <[string]> metas;
    in property <int> selected;
    in property <int> focused: -1;
    callback activated(int);
    width: 57.59px;
    for ic[i] in root.icons: Rectangle {
        x: 0px; y: (parent.height - root.icons.length * 76.79px) / 2 + i * 76.79px; width: parent.width; height: 76.79px;
        background: root.focused == i ? #ffffff : (root.selected == i ? #ffffff1a : transparent);
        animate background { duration: 50ms; easing: cubic-bezier(0, 0, 0.58, 1); }
        accessible-role: button;
        accessible-label: root.labels[i];
        accessible-description: root.metas[i];
        Icon {
            x: 14.39px; y: 24px; src: ic; s: 28.8px;
            c: root.focused == i ? #0e141b : (root.selected == i ? #ffffff : #8b929a);
            transform-scale: root.selected == i ? 1.1 : 1.0;
            animate transform-scale { duration: 320ms; easing: cubic-bezier(0.17, 0.45, 0.14, 0.83); }
        }
        TouchArea { clicked => { root.activated(i); } }
    }
    // rail divider (live screenshot docs/reference/live/08-qam.png: 2 px rgba(255,255,255,.1) at the rail's right edge)
    Rectangle { x: parent.width - 2.4px; width: 2.4px; background: #ffffff1a; }
}

// Sticky title bar (halo #0e141b 0 0 7 12) + optional right-hand buttons are drawn by the tab content.
export component GQamTitle inherits Rectangle {
    in property <string> text;
    y: 0px;
    height: 57.58px;
    background: transparent;
    Rectangle { y: 0px; height: parent.height; background: #0e141b; drop-shadow-color: #0e141b; drop-shadow-blur: 22.8px; }
    Text { x: 19.19px; y: 23.99px; height: 33.59px; text: root.text; vertical-alignment: center;
        font-family: GStyle.loc-font; font-size: 26.4px; font-weight: 700; color: #ffffff; overflow: elide; width: parent.width - 19.19px - 12px; }
}

// Section header (16px 600 uppercase, ls 0.5px, rgba(255,255,255,0.7)), 29.99 css high incl. 8 css bottom padding.
export component GQamHeader inherits Rectangle {
    in property <string> text;
    height: 35.99px;
    Text { x: 19.19px; y: 0px; width: parent.width - 38.38px; height: parent.height - 9.6px; text: root.text; wrap: word-wrap; vertical-alignment: top;
        font-family: GStyle.loc-font; font-size: 19.2px; font-weight: 600; letter-spacing: 0.6px; color: #ffffffb3; }
}

// Row chrome shared by slider/toggle/button rows (radius 2px, focus = rgba(255,255,255,.1)).
export component GQamSliderRow inherits Rectangle {
    in property <image> icon;
    in property <float> value; // <0 unavailable
    in property <bool> focused;
    in property <bool> adjusting;
    in property <string> label;
    in property <string> meta;
    in property <bool> line: true;
    callback clicked;
    callback changed(float);
    height: 52.8px;
    border-radius: 2.4px;
    background: root.focused ? #ffffff1a : transparent;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-description: root.meta;
    opacity: root.value < 0 ? 0.4 : 1;
    Icon { x: 19.19px; y: (parent.height - self.height) / 2; src: root.icon; s: 24px; c: #969696; }
    Rectangle {
        x: 55.19px; y: 12px; width: 288px; height: 28.8px;
        Rectangle { y: (parent.height - self.height) / 2; width: parent.width; height: 7.19px; border-radius: 3.6px; background: #ffffff26;
            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * clamp(root.value, 0, 1); border-radius: parent.border-radius; background: #1a9fff; animate width { duration: 80ms; } }
        }
        Rectangle { x: (parent.width - self.width) * clamp(root.value, 0, 1); y: 0px; width: 28.8px; height: 28.8px; border-radius: self.height / 2; background: #ffffff;
            border-width: root.adjusting ? 3.6px : 0px; border-color: #ffffff26;
            drop-shadow-color: #00000059; drop-shadow-blur: 6px; animate x { duration: 80ms; } }
    }
    Rectangle { x: 19.19px; y: parent.height - 1.19px; width: parent.width - 38.38px; height: 1.19px; background: #ffffff1a; visible: root.line; }
    TouchArea {
        enabled: root.value >= 0;
        clicked => { root.clicked(); }
        pointer-event(e) => { if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) { root.changed(clamp((self.mouse-x - 55.19px - 14.4px) / (288px - 28.8px), 0, 1)); } }
    }
}

export component GQamToggleRow inherits Rectangle {
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <string> label;
    in property <int> on; // 1 on, 0 off, -1 n/a
    in property <bool> focused;
    in property <length> text-h: 24px;
    in property <string> meta;
    in property <bool> line: true;
    callback clicked;
    height: 50.39px;
    border-radius: 2.4px;
    background: root.focused ? #ffffff1a : transparent;
    accessible-role: switch;
    accessible-label: root.label;
    accessible-description: root.meta;
    opacity: root.on < 0 ? 0.4 : 1;
    if root.has-icon: Icon { x: 19.19px; y: 13.2px; src: root.icon; s: 24px; c: #dcdedf; }
    Text { x: 55.19px - (root.has-icon ? 0px : 36px); y: 13.2px; width: 220.85px + (root.has-icon ? 0px : 36px); height: root.text-h; text: root.label; wrap: word-wrap; vertical-alignment: top;
        font-family: GStyle.loc-font; font-size: 19.2px; color: #dcdedf; }
    // the one DeckShell switch (widgets/toggle.slint), right edge where the stock QAM rail ends
    Toggle { x: 336.01px - self.width; y: (parent.height - self.height) / 2; on: root.on; focused: root.focused; }
    Rectangle { x: 19.19px; y: parent.height - 1.19px; width: parent.width - 38.38px; height: 1.19px; background: #ffffff1a; visible: root.line; }
    TouchArea { clicked => { root.clicked(); } }
}

// Dialog-style button row (Decky plugin entries, Advanced switch...): 40 css button in a 60 css row.
export component GQamButtonRow inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <string> rtext;
    in property <bool> focused;
    in property <bool> has-icon: true;
    in property <string> meta;
    callback clicked;
    height: 72px;
    accessible-role: button;
    accessible-label: root.label;
    accessible-description: root.meta;
    Rectangle {
        x: 19.19px; y: (parent.height - self.height) / 2; width: 321.62px; height: 48px; border-radius: 2.4px;
        background: root.focused ? #ffffff : #ffffff26;
        drop-shadow-color: root.focused ? #00000040 : transparent; drop-shadow-offset-y: 4.8px; drop-shadow-blur: 4.8px;
        animate background { duration: 100ms; }
        if root.has-icon: Icon { x: 28.8px; y: (parent.height - self.height) / 2; src: root.icon; s: 19.2px; c: root.focused ? #23262e : #dcdedf; }
        Text { x: 0px; width: parent.width - 28.8px; height: parent.height; text: root.label; horizontal-alignment: root.has-icon ? right : center; vertical-alignment: center; overflow: elide;
            font-family: GStyle.loc-font; font-size: 19.2px; font-weight: 400; color: root.focused ? #23262e : #dcdedf; }
        if root.rtext != "": Text { x: 0px; width: parent.width - 28.8px; height: parent.height; text: root.rtext; horizontal-alignment: right; vertical-alignment: center;
            font-family: GStyle.loc-font; font-size: 19.2px; font-weight: 700; color: #1a9fff; }
    }
    TouchArea { clicked => { root.clicked(); } }
}

// Slider with notch captions (text size, overlay level): 62.99 css row; captions 10px bold uppercase.
export component GQamNotchRow inherits Rectangle {
    in property <float> value;
    in property <string> cap-left;
    in property <string> cap-right;
    in property <int> notches: 0;
    in property <bool> focused;
    in property <string> label;
    in property <string> meta;
    in property <bool> line: true;
    callback clicked;
    callback changed(float);
    height: 75.59px;
    border-radius: 2.4px;
    background: root.focused ? #ffffff1a : transparent;
    accessible-role: slider;
    accessible-label: root.label;
    accessible-description: root.meta;
    Rectangle {
        x: 19.19px; y: 16.8px; width: 324px; height: 28.8px;
        Rectangle { y: (parent.height - self.height) / 2; width: parent.width; height: 7.19px; border-radius: 3.6px; background: #ffffff26;
            Rectangle { x: 0px; y: 0px; height: parent.height; width: parent.width * clamp(root.value, 0, 1); border-radius: parent.border-radius; background: #1a9fff; animate width { duration: 80ms; } } }
        for k in root.notches: Rectangle { x: (parent.width - 28.8px) * (root.notches > 1 ? k / (root.notches - 1) : 0) + 13.2px; y: (parent.height - self.height) / 2; width: 2px; height: 12px; background: #ffffff59; }
        Rectangle { x: (parent.width - 28.8px) * clamp(root.value, 0, 1); width: 28.8px; height: 28.8px; border-radius: self.height / 2; background: #ffffff;
            drop-shadow-color: #00000059; drop-shadow-blur: 6px; animate x { duration: 80ms; } }
    }
    Text { x: 19.19px; y: 55.19px; height: 18px; text: root.cap-left; vertical-alignment: center;
        font-family: GStyle.loc-font; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; color: #969696; }
    Text { x: 19.19px; width: 324px; y: 55.19px; height: 18px; text: root.cap-right; horizontal-alignment: right; vertical-alignment: center;
        font-family: GStyle.loc-font; font-size: 12px; font-weight: 700; letter-spacing: 0.6px; color: #969696; }
    Rectangle { x: 19.19px; y: parent.height - 1.19px; width: parent.width - 38.38px; height: 1.19px; background: #ffffff1a; visible: root.line; }
    TouchArea {
        clicked => { root.clicked(); }
        pointer-event(e) => { if (e.kind == PointerEventKind.down || (e.kind == PointerEventKind.move && self.pressed)) { root.changed(clamp((self.mouse-x - 19.19px - 14.4px) / (324px - 28.8px), 0, 1)); } }
    }
}

export component GQamSep inherits Rectangle {
    height: 1.19px;
    Rectangle { x: 19.19px; width: parent.width - 38.38px; background: #ffffff1a; }
}

// Plain list entry (friends, notifications): 52.8px high, avatar circle + two text lines.
export component GQamEntry inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <color> accent: #969696;
    in property <image> avatar;
    in property <bool> has-avatar;
    in property <bool> friend;
    in property <bool> focused;
    in property <string> meta;
    in property <bool> header;
    callback clicked;
    height: 52.8px;
    border-radius: 2.4px;
    background: root.focused ? #ffffff1a : transparent;
    accessible-role: button;
    accessible-label: root.name + " " + root.sub;
    accessible-description: root.meta;
    if !root.header: Rectangle { x: 20.4px; y: root.friend ? 4.8px : 7.8px; width: root.friend ? 43.2px : 37.2px; height: self.width; background: #23262e; border-radius: 2.4px; border-width: 2.4px; border-color: root.accent; clip: true;
        if root.has-avatar: Image { width: parent.width; height: parent.height; source: root.avatar; image-fit: cover; } }
    if root.header: Rectangle { x: 19.19px; y: parent.height - 1.2px; width: parent.width - 38.38px; height: 1.2px; background: root.accent; }
    if root.header: Text { x: 19.19px; width: parent.width - 38.38px; height: parent.height; text: root.name; vertical-alignment: center; overflow: elide;
        font-family: GStyle.loc-font; font-size: 19.2px; font-weight: 600; letter-spacing: 0.6px; color: #ffffffb3; }
    if !root.header: Text { x: 67.2px; y: 4.8px; width: parent.width - 81.6px; height: 24px; text: root.name; vertical-alignment: center; overflow: elide;
        font-family: GStyle.loc-font; font-size: 19.2px; color: #dcdedf; }
    if !root.header: Text { x: 67.2px; y: 28.8px; width: parent.width - 81.6px; height: 19.2px; text: root.sub; vertical-alignment: center; overflow: elide;
        font-family: GStyle.loc-font; font-size: 14.4px; color: root.accent; }
    TouchArea { clicked => { root.clicked(); } }
}
