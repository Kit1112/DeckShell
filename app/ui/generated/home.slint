            width: 19.2px + lab.preferred-width + (t.badge != "" ? 9.6px + bdg.width + 9.6px : 19.2px);
            pill := Rectangle {
                y: 0px; height: parent.height; width: parent.width;
                border-radius: 76.8px;
                property <bool> foc: root.focused-tab == i;
                background: foc ? #ffffff : (t.selected ? #ffffff26 : #00000000);
                drop-shadow-color: foc ? #00000052 : #00000000; drop-shadow-offset-y: foc ? 3.6px : 0px; drop-shadow-blur: foc ? 7.2px : 0px;
                animate background, drop-shadow-color, drop-shadow-offset-y, drop-shadow-blur { duration: 100ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
            }
            lab := Text { x: 19.2px; y: 10.38px; height: 20px; text: t.label.to-uppercase(); font-family: GStyle.loc-font;
                          color: (pill.foc ? #23262e : (t.selected ? #ffffff : #dcdedf)); font-size: 14.4px; font-weight: 700; letter-spacing: GStyle.loc-ls-k * 0.6px; vertical-alignment: center;
                          animate color { duration: 100ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); } }
            bdg := Rectangle {
                x: 19.2px + lab.preferred-width + 9.6px; y: 7.19px;
                width: t.badge == "" ? 0px : max(55.19px, 19.19px + bt.preferred-width + 7.2px);
                height: 26.39px; border-radius: 24px; background: #236c39; visible: t.badge != "";
                HorizontalLayout { alignment: space-evenly; padding-left: 3.6px; padding-right: 3.6px;
                    Rectangle { width: 19.19px; Icon { x: 0px; y: 3.6px; src: Icons.friends; s: 19.19px; } }
                    bt := Text { text: t.badge; color: #ffffff; font-size: 14.4px; font-weight: 700; letter-spacing: 0.6px; vertical-alignment: center; }
                }
            }
            TouchArea { clicked => { root.activated(i); } }
        }
        Rectangle { width: 28.8px; }
    }
