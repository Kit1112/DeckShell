// Title + playtime line. Left layout (first tile focused, x/y/size from dump): title left-aligned at 27.46/345.51 css,
// playtime row centred on the 430-wide tile holder. Centred layout (other tiles focused): both centred on the window.
export component GHomeHero inherits Rectangle {
    in property <string> title;
    in property <string> sub;
