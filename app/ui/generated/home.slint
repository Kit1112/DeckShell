    Text {
        x: root.centered ? 0px : 32.15px; y: 318px + root.dy;
        width: root.centered ? root.width : 652.49px; height: 36px;
        text: root.title; color: #ffffff; font-size: 27px; font-weight: 800; horizontal-alignment: root.centered ? center : left; overflow: elide; vertical-alignment: center;
    }
    HorizontalLayout {
        x: root.centered ? 0px : 35.87px; width: root.centered ? root.width : 645.06px;
        y: 354px + root.dy; height: 21px; spacing: 8.99px; alignment: center;
        Rectangle { width: 17.99px;
            Path { x: 2.4px; y: 2.7px; width: 10px; height: 11.41px; viewbox-width: 8.33; viewbox-height: 9.51;
                   commands: "M0 0 L8.33 4.76 L0 9.51 Z"; fill: #59bf40; visible: root.title != ""; } }
        Text { text: root.sub.to-uppercase(); font-family: GStyle.loc-font; color: #ffffff80; font-size: 18px; font-weight: 700; letter-spacing: GStyle.loc-ls-k * 0.75px; vertical-alignment: center; }
    }
}

// No per-cover glow layer: the Steam glow is a blurred, z-index -1 copy of the art, which Slint cannot blur. The previous
// flat average-colour wash drew a visible backing plate 72px below the focused cover (owner report, build test 3f66bad),
// so it was removed; the test home_focus_plate_ignores_glow in app/src/fixture_gallery.rs guards against its return.

// Recents tile. Generated from the unfocused node (WYgDg9NyCcMIVuMyZ_NBC) and the focused .gpfocus node (WYgDg9NyCcMIVuMyZ_NBC):
// focused transform scale 1.02 (visual 440.31/430.04 css), shadow, brightness/saturate (grey-overlay approximation),
// outline 2px #ffffff99 with grow keyframes (+10px) and pulse (min alpha x0.4).
export component GHomeTile inherits Rectangle {
    in property <image> art;
    in property <bool> has-art;
    in property <image> wide-art;
    in property <bool> has-wide;
    in property <string> name;
    in property <bool> focused;
    in property <bool> wide-mode;
    in property <bool> ambient: true;
    callback tapped;
    width: root.wide-mode ? 645.06px : 201px;
    height: 301.5px;
    background: transparent;
    z: root.focused ? 10 : 0;
    property <bool> show-wide: root.wide-mode && root.has-wide;
    property <bool> show-port: !root.show-wide && root.has-art;
    property <float> sc: 1;
    property <length> sh-dx: 0px;
    property <length> sh-dy: 4.8px;
    property <length> sh-blur: 12px;
    property <color> sh-col: #00000040;
    property <float> dim-a: 0.63;
    property <color> dim-col: #0a0a0a;
    property <length> ring-grow: 10px;
    property <float> ring-a: 0;
    property <float> pm: 0; // pulse mix; the pulse wave itself is Shell.pulse (Rust-driven, frame-capped)
    states [
        focused when root.focused: {
            sc: 1.02; sh-dx: 0px; sh-dy: 19.2px; sh-blur: 28.8px; sh-col: #00000080;
            dim-a: 0; dim-col: #000000; ring-grow: 0px; ring-a: 1; pm: root.ambient ? 1 : 0;
            in {
                animate sc { duration: 300ms; easing: cubic-bezier(0.16, 0.86, 0.43, 0.99); }
                
                
                animate ring-grow { duration: 400ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                animate ring-a { duration: 400ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
                // The shared pulse clock supplies the CSS delay and restarts on Home focus changes.
            }
            out {
                animate sc { duration: 400ms; easing: cubic-bezier(0, 0.73, 0.48, 1); }
                animate sh-dx, sh-dy, sh-blur, sh-col { duration: 400ms; easing: cubic-bezier(0, 0.73, 0.48, 1); }
                animate dim-a, dim-col { duration: 400ms; easing: cubic-bezier(0, 0.73, 0.48, 1); }
            }
        }
    ]
    scaled := Rectangle {
        transform-scale: root.sc;
        vis := Rectangle {
            background: #0e141b;
            drop-shadow-color: root.sh-col; drop-shadow-offset-x: root.sh-dx; drop-shadow-offset-y: root.sh-dy; drop-shadow-blur: root.sh-blur;
            clip: true;
            if root.show-wide: Image { width: parent.width; height: parent.height; source: root.wide-art; image-fit: cover; }
            if root.show-port: Image { width: parent.width; height: parent.height; source: root.art; image-fit: cover; }
            if !root.show-port && !root.show-wide: Rectangle {
                background: @linear-gradient(180deg, #0e141b.brighter(0.25) 0%, #0e141b 100%);
                Text { x: 16px; y: 24px; width: parent.width - 32px; height: parent.height - 30px; text: root.name; color: #dcdedf; font-size: 14.4px; font-weight: 400;
                       wrap: word-wrap; horizontal-alignment: center; vertical-alignment: top; overflow: elide; }
            }
            Rectangle { background: root.dim-col; opacity: root.dim-a; }
        }
        Rectangle {
            x: -(2px + 2px + root.ring-grow); y: -(2px + 2px + root.ring-grow);
            width: parent.width + 2 * (2px + 2px + root.ring-grow); height: parent.height + 2 * (2px + 2px + root.ring-grow);
            border-width: 2px + root.ring-grow;
            border-color: #ffffff.transparentize(1 - 0.6 * root.ring-a * (1 - root.pm * (1 - Shell.pulse)));
        }
    }
    TouchArea { clicked => { root.tapped(); } }
}

// "Open library" tile (GamepadHome_GoToLibrary, sp.js:383486 -> LibraryTab("AllGames")): last item of the recents row, portrait-sized grey panel,
// no scale, centred 2-line label, 2px #ffffff outline ring when focused. Measured from docs/cdp/extents/home-recents-end.png (panel #3b3d3f -> #303234).
