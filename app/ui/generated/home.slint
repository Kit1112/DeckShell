               wrap: word-wrap; horizontal-alignment: center; vertical-alignment: center; }
    }
    Rectangle {
        x: -2px; y: -2px; width: parent.width + 4px; height: parent.height + 4px;
        border-width: 2px; border-color: root.focused ? #ffffff.transparentize(1 - 0.6 * (1 - 0.6 * (1 - Shell.pulse))) : #00000000;
        animate border-color { duration: 200ms; }
    }
    TouchArea { clicked => { root.tapped(); } }
}

// Recents scroller: clip = scroller node (y 316.5 h 310.99 css), padding-left 29.88, wide holder 442.04, portrait pitch 145.99, tile top 85 below scroller top.
export component GHomeRecents inherits Rectangle {
    in property <[CardData]> model;
    in property <int> idx;
    in property <bool> active: true;
    in property <bool> ambient: true;
    in property <int> anim-id: -1;
    in property <image> anim-image;
    in property <string> lib-label;
    callback activated(int);
    x: 0px; y: 274.5px; height: 466.5px;
    clip: true;
    // focused tile kept in view: scrollLeft tween (JS in Steam, ~135ms ease-in-out, cdp-spec Animations)
    property <length> scroll-x: root.idx <= 0 ? 0px : max(0px, 698.93px + (root.idx - 1) * 219px + 201px + 35.87px - root.width);
    if root.model.length > 0: GHomeLibTile {
        x: 698.93px + (root.model.length - 1) * 219px - root.scroll-x;
        y: 127.5px;
        animate x { duration: 135ms; easing: cubic-bezier(0.42, 0, 0.58, 1); }
        label: root.lib-label; focused: root.active && root.idx == root.model.length;
        tapped => { root.activated(root.model.length); }
    }
    for c[i] in root.model: GHomeTile {
        x: (i == 0 ? 35.87px : 698.93px + (i - 1) * 219px) - root.scroll-x;
        y: 127.5px;
        animate x { duration: 135ms; easing: cubic-bezier(0.42, 0, 0.58, 1); }
        art: (c.id == root.anim-id) ? root.anim-image : c.img;
        has-art: c.has-img || c.id == root.anim-id;
        wide-art: c.wide; has-wide: c.has-wide; name: c.name;
        focused: root.active && root.idx == i; wide-mode: i == 0; ambient: root.ambient;
        tapped => { root.activated(i); }
    }
}

// Section tabs (What's New / Friends / Recommended): pill h 33.97 css r 64px, padding 6px 8px 6px 16px (no badge: 6px 16px),
// states: selected (bg rgba(255, 255, 255, 0.15)), normal (transparent, rgb(220, 222, 223)), focused (white bg, rgb(35, 38, 46), shadow rgba(0, 0, 0, 0.32) 0px 3px 6px 0px); 100ms cubic-bezier(0.25, 0.1, 0.25, 1).
export struct GTab { label: string, badge: string, selected: bool }
export component GHomeTabs inherits Rectangle {
    in property <[GTab]> tabs;
    in property <int> focused-tab: -1;
