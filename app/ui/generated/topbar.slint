import { SearchField } from "../widgets/search_field.slint";
import { Icon, Icons } from "../widgets/icon.slint";

export component GTopBar inherits Rectangle {
    in property <bool> compact: false;
    in property <float> scrim: 0;
    property <length> row-padding: root.compact ? 0px : HeaderLayout.padded-offset;
    animate row-padding { duration: 400ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    property <float> search-open: HeaderLayout.search-expanded ? 1 : 0;
    animate search-open { duration: 240ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); }
    out property <length> search-left: search.x;
    height: HeaderLayout.row-height + root.row-padding;
    background: transparent;
    // Focus zone "header": the dark strip fades in under the whole row and everything below loses its focus.
    Rectangle { y: 0px; height: HeaderLayout.strip-height; background: #000000; opacity: HeaderLayout.bar-focused ? 0.55 : 0;
        animate opacity { duration: 200ms; easing: cubic-bezier(0.25, 0.1, 0.25, 1); } }
    Rectangle { background: #000000; opacity: root.scrim * 0.5; }
