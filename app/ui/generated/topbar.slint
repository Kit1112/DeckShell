            s: 26.99px; c: TopBarState.hfocus == 4 ? #23262e : #ffffff; tint: !TopBarState.wifi-offline;
        }
        if TopBarState.bat-pct >= 0 && TopBarState.bat-show-pct: Text {
            x: row.width - 115.06px; y: 2.4px; width: 50.56px; height: 55.2px;
