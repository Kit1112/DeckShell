        HeaderBlocks { x: 0px; y: 0px; width: parent.width; left-padding: root.row-padding; }
        Rectangle {
            x: root.row-padding + 8.99px; y: 6px; width: 47.99px; height: 47.99px;
            background: TopBarState.has-avatar ? transparent : #23262e;
            if TopBarState.has-avatar: Image { width: parent.width; height: parent.height; source: TopBarState.avatar; image-fit: cover; }
        }
        Text {
            x: root.row-padding + 86.98px; y: 2.4px; width: clamp(search.x - self.x, 0px, 69.23px + (TopBarState.clock-12h ? 28px : 0px)); height: 55.2px;
            text: TopBarState.clock; color: #ffffff; font-size: 24px; font-weight: 500; overflow: elide; horizontal-alignment: TopBarState.clock-12h ? left : right; vertical-alignment: center;
