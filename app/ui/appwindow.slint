         HomeState, LibraryState, GameState, DownloadsState, SettingsState, MediaState, SearchState, SteamMenuState, QamState }

export component AppWindow inherits Window {
    in property <bool> dry-run: false;
    in property <string> dry-run-label;
    title: "DeckShell";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 400px;
    // Always create an alpha-capable native surface. The opaque page is a child,
    // so a menu can transition to an overlay without recreating/unmapping it.
    background: transparent;
    default-font-size: 16px;
    default-font-family: Tokens.font-family;

    fs := FocusScope {
        init => { self.focus(); }
        focus-changed-event(reason) => { Shell.animation-key-reset(); }
        capture-key-pressed(e) => {
            if (Shell.animation-key(e.text, true, e.repeat, e.modifiers.control || e.modifiers.alt || e.modifiers.shift || e.modifiers.meta)) { accept } else { reject }
        }
        capture-key-released(e) => {
            if (Shell.animation-key(e.text, false, e.repeat, e.modifiers.control || e.modifiers.alt || e.modifiers.shift || e.modifiers.meta)) { accept } else { reject }
        }
        key-pressed(e) => {
            if (Shell.key(e.text, e.modifiers.control, e.repeat)) { accept } else { reject }
        }

        Rectangle {
        visible: !Shell.game-overlay;
        background: Tokens.bg;
        Backdrop { }
        HomeScreen { }
        LibraryScreen { }
        SearchScreen { }
        GameScreen { }
        DownloadsScreen { }
        SettingsScreen { }
        MediaScreen { }
        if Shell.library-status != "" && (Shell.page == 0 || Shell.page == 1 || Shell.page == 6): Rectangle {
            x: 32px; y: 110px; width: parent.width - 64px; height: 64px; background: #18202bf0;
            accessible-role: text; accessible-label: Shell.library-status;
            Text { x: 18px; width: parent.width - 36px; height: parent.height; text: Shell.library-status; color: Tokens.text; font-size: 20px; vertical-alignment: center; wrap: word-wrap; }
        }
        }
        SteamMenu { }
        DownloadsMenuPanel { x: 360px; y: 60px; width: 600px; height: parent.height - 120px; }
        Qam { }
        SgdbScreen { visible: !Shell.game-overlay && SgdbState.open; width: root.width; height: root.height; }
        PropertiesScreen { visible: !Shell.game-overlay && (PropsState.open || PropsState.popup-open || PropsState.osk-open || PropsState.dlg-open); x: 0px; y: 0px; width: root.width; height: root.height; }
        ControllerScreen { visible: !Shell.game-overlay && ControllerState.open; x: 0px; y: 0px; width: root.width; height: root.height; }
        top-bar := GTopBar {
            x: 0px; y: MediaState.viewer-open ? -self.height : 0px; width: root.width;
            opacity: MediaState.viewer-open ? 0.2 : 1;
            animate y, opacity { duration: 500ms; easing: ease-in-out; }
            compact: ControllerState.open || (Shell.page != 0 && Shell.page != 2);
        }
        if ControllerState.open && !Shell.game-overlay: Text {
            x: 237px; y: 0px; width: max(0px, min(700px, top-bar.search-left - self.x - 12px)); height: 60px;
            text: ControllerState.browser-open ? ControllerText.load-new-layout : ControllerState.title;
            color: #dcdedf; font-size: 23.7px; font-family: GStyle.loc-font;
            vertical-alignment: center; overflow: elide;
        }
        if ControllerGyroState.shown && !Shell.game-overlay: ControllerGyroModal {
            width: root.width; height: root.height;
        }
        GFooterBar { x: 0px; y: root.height - self.height; width: root.width; top-row-hints: ControllerState.open && ControllerState.pad-two-line ? 2 : 0; clicked(i) => { Shell.footer-clicked(i); } }
        // окна входа и установки лежат ниже экранной клавиатуры: поле пароля вызывает её поверх окна
        AccountScreen { x: 0px; y: 0px; width: root.width; height: root.height; }

        InstallWizard { x: 0px; y: 0px; width: root.width; height: root.height; }
        SearchOsk { x: 0px; y: 0px; width: root.width; height: root.height; }
        SortMenu { }
        HotkeysLayer { x: 0px; y: 0px; width: root.width; height: root.height; }
        PowerConfirm { x: 0px; y: 0px; width: root.width; height: root.height; }

        if !ToastState.external: NotificationStack { viewport-width: root.width; viewport-height: root.height; }

        // brightness / volume popup (Decky Brightness Bar look), below the boot/suspend cover
        if !Shell.level-external : LevelBar { kind: Shell.level-kind; value: Shell.level-value; icon: Shell.level-icon; shown: Shell.level-shown; }

        // boot / suspend / shutdown animation cover (src/anim): always the top-most layer
        AnimOverlay { x: 0px; y: 0px; width: root.width; height: root.height; }
        // Play/Resume cover until the game window has focus (task 330, src/launch_splash.rs); below the boot cover
        LaunchSplash { x: 0px; y: 0px; width: root.width; height: root.height; }
        // idle screensaver (task 518, src/idle.rs): above everything but the test-mode banner
        IdleCover { x: 0px; y: 0px; width: root.width; height: root.height; }
        if root.dry-run: Rectangle {
            x: 0px; y: 0px; width: root.width; height: 52px; background: #c51c24;
            accessible-role: text; accessible-label: root.dry-run-label;
            Text { width: parent.width; height: parent.height; text: root.dry-run-label; color: white; font-size: 22px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
}
